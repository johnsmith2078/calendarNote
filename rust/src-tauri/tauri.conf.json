{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "calendarNote",
  "version": "0.1.0",
  "identifier": "com.calendarnote.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "日历笔记本",
        "width": 1320,
        "height": 860,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../../icon.ico"
    ]
  }
}
